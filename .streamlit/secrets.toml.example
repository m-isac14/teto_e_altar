# ========================================================
# Segredos do Streamlit - Teto & Altar (Supabase / Local)
# ========================================================
# No Streamlit Cloud: Cole em "App Settings" > "Secrets"
# No Computador: Renomeie uma cópia para ".streamlit/secrets.toml"

# 1. Banco de Dados Relacional (PostgreSQL - Supabase ou Neon) [RECOMENDADO]
# Substitua pela URI de conexão do seu projeto Supabase:
[connections.postgresql]
url = "postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Chave secreta da aplicação
SECRET_KEY = "sua_chave_secreta_super_segura"
